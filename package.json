{
  "name": "flux-dj",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:lint": "supabase db lint --level warning --fail-on warning",
    "db:types": "supabase gen types typescript --local --schema public > src/lib/supabase/database.types.ts",
    "check": "pnpm lint && pnpm typecheck && pnpm test:unit && pnpm db:lint && pnpm db:test && pnpm test:integration && pnpm test:e2e",
    "test:integration": "vitest run tests/integration --no-file-parallelism",
    "test:unit": "vitest run tests/unit",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.2",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.49.0",
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "shadcn": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "supabase": "2.119.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "5.0.3"
  },
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=20.9"
  }
}
