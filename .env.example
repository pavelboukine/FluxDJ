# Copy to .env.local and fill in. Never commit real credentials.
# For local development, `pnpm db:start` prints the local URL and keys
# (or run `pnpm exec supabase status`).

# Public (inlined into the browser bundle; must not be secret)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-anon-key
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000

# Server only. Bypasses row-level security. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key

# Derives proposal link tokens (HMAC). At least 32 random characters, e.g.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Rotating it makes retries of undelivered proposal emails fail visibly.
PROPOSAL_LINK_SECRET=replace-with-32-plus-random-characters

# Email delivery: mailpit (local, http://127.0.0.1:54324), resend (hosted) or disabled.
EMAIL_TRANSPORT=mailpit
EMAIL_FROM_ADDRESS=proposals@fluxdj.local
MAILPIT_URL=http://127.0.0.1:54324
# Only for EMAIL_TRANSPORT=resend (hosted). Never commit a real key.
# RESEND_API_KEY=

# Protects /api/internal/outbox (pnpm outbox:work, or a hosted cron job).
OUTBOX_WORKER_SECRET=replace-with-32-plus-random-characters
