# Copy to .env.local and fill in. Never commit real credentials.
# For local development, `pnpm db:start` prints the local URL and keys
# (or run `pnpm exec supabase status`).

# Public (inlined into the browser bundle; must not be secret)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-anon-key
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000

# Server only. Bypasses row-level security. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key
